# Kwatern as a systemd service; see "Running as a service" in README.md.
#
# Install: copy the binary to /usr/local/bin/kwatern and this file to /etc/systemd/system/kwatern.service, then
#   useradd --system --home-dir /var/lib/kwatern --shell /usr/sbin/nologin kwatern
#   systemctl enable --now kwatern
# and put the export in /var/lib/kwatern. Change the options on ExecStart to suit the site.

[Unit]
Description=Kwatern, web viewer for Gramps exports
Documentation=https://github.com/PetrHejl/kwatern
After=network.target

[Service]
Type=exec
User=kwatern
Group=kwatern
# /var/lib/kwatern for the export, users.txt and session.key; /var/cache/kwatern for the media of a package.
StateDirectory=kwatern
StateDirectoryMode=0750
CacheDirectory=kwatern
CacheDirectoryMode=0700
WorkingDirectory=/var/lib/kwatern
UMask=0077

ExecStart=/usr/local/bin/kwatern -Xmx128m family.gpkg \
    --host 127.0.0.1 --port 8080 --behind-proxy \
    --extract-dir /var/cache/kwatern
# For a site where members sign in, add to ExecStart:
#   --access=members --users users.txt --secret-file session.key
# and add members with: sudo -u kwatern /usr/local/bin/kwatern passwd --users /var/lib/kwatern/users.txt NAME

# A Java program stopped by SIGTERM exits with 143.
SuccessExitStatus=143
Restart=on-failure
RestartSec=5s

# Sandboxing: the server only reads the export and writes to its state and cache directories.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
# Not ProcSubset=pid: it hides /proc/mounts, which Java reads to find the free space for a package's media.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
